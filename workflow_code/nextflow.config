plugins {
  id 'nf-schema@2.8.0'
}
//***************************************** Global parameters *******************************************//
params {
    entry_point = 'raw_reads'
    stage_only = false
    truncate_to = null
    post_processing = false
    validate_params = true
    version = false
    runsheet = null

    dp_tools_plugin = null
    api_url = "https://visualization.osdr.nasa.gov/biodata/api/v2/dataset/*/"
    
    assay_suffix  = "_GLAmpSeq"
    prepend_target_region = true // If true, prepend target_region to assay_suffix (a 16S run publishes _16S_GLAmpSeq). Set to false to use assay_suffix as written
    output_prefix = ""

    outdir = "${launchDir}"
    
    // Mandatory parameters 
    target_region = "16S" // "16S", "18S", "ITS"
    trim_primers  = true
    

    // Input options
    // Mandatory parameters if using GLDS or OSD accession as input
    accession = null
    // -------- Required only if --accession is false ---------------//
    // A 4-column (single-end) or 5-column (paired-end) input csv file with the following headers ( sample_id, forward, [reverse,] paired, groups)
    input_file = null 

    isa_archive = null // If a runsheet is not supplied, ISA.zip will be pulled from OSDR unless this is supplied
    specify_runsheet = null // Specify a runsheet by name when multiple runsheets match the same target region

    // Debugging input options
    limit_samples_to            = null // Limit the number of samples to process
    force_single_end            = null // Force single-end mode by specifying which read to use (Set to either "R1" or "R2")

    // Cutadapt parameters
    min_cutadapt_len    = 130
    primers_linked      = true
    discard_untrimmed   = true
    anchored_primers    = true
    F_primer            = null
    R_primer            = null


    // Dada2 parameters
    left_trunc     = 0
    right_trunc    = 0
    left_maxEE     = 1
    right_maxEE    = 1
    concatenate_reads_only = false


    // Minimum desired sample rarefaction depth for diversity analysis
    rarefaction_depth  = 500


    // -------- Differential abundance parameters ----- //
    diff_abund_method  = "all" // ["all", "ancombc1", "ancombc2", or "deseq2"] - it runs all three by default
    group              = "groups"  // column in input csv file to be compared
    samples_column     = "sample_id" // column in input csv file containing sample names
    remove_struc_zeros = false // should structural zeros be removed when running ANCOMBC?
    // Should rare features and samples be discarded. Values are true or false. If set to true then set the cutoffs below
    remove_rare        = false
    prevalence_cutoff  = 0  // a fraction between 0 and 1 that represents the prevalance in percentage of taxa to be retained
    library_cutoff     = 0 // Samples with library sizes less than this number will be excluded in the analysis

    database_store_path = "./Reference_DBs" //Dictates where the reference databases will be stored

    publish_dir_mode = "link" // "link", "copy

    // Multiqc
    multiqc_config = "${projectDir}/conf/multiqc.config"


    // If using conda environments specify their locations so new ones won't be created
    // Specify the paths to existing conda environments (/path/to/envs/cutadapt)
    // leave as is if you want to create a new conda environment
    conda_cutadapt         = null     // /path/to/envs/cutadapt
    conda_diversity        = null     // /path/to/envs/R_diversity
    conda_dp_tools         = null     // /path/to/envs/dp_tools
    conda_fastqc           = null     // /path/to/envs/fastqc
    conda_multiqc          = null     // /path/to/envs/multiqc
    conda_R                = null     // /path/to/envs/R
    conda_zip              = null     // /path/to/envs/zip
    conda_wget             = null     // /path/to/envs/wget
 
    errorStrategy  = "terminate"
    debug          = false // set to true if you'd like to see the values of your set parameters
    help           = false
    helpFull       = false
    showHidden     = false
}

// Workflow output settings
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Setting the default container engine as singularity
params.containerEngine = "singularity"
// Conda shouldn't be used by default except when using conda-based profiles
params.use_conda = false


/*******************************************************************************************************
*************************************** Workflow Profiles **********************************************
********************************************************************************************************/

profiles {
    local { includeConfig 'conf/local.config' }

    slurm { includeConfig 'conf/slurm.config' }

    conda {
        docker.enabled = false
        singularity.enabled = false

        conda.enabled          = true
        params.use_conda       = true
        conda.channels         = 'conda-forge,bioconda'
        conda.cacheDir         = 'conda/' // location of conda environments
        conda.createTimeout    = '2h'
        includeConfig 'conf/by_conda_env.config'
    }

    mamba {
        docker.enabled = false
        singularity.enabled = false

        conda.enabled          = true
        conda.useMamba         = true
        conda.channels         = 'conda-forge,bioconda'
        params.use_conda       = true
        conda.cacheDir         = 'conda/' // location of conda environments
        conda.createTimeout    = '2h'
        includeConfig 'conf/by_conda_env.config'
    }

    singularity {
        params.use_conda = false
        docker.enabled = false
        conda.enabled = false

        singularity.enabled    = true
        singularity.autoMounts = true

        /* Uncomment the line below  if you'd like to set the cache directory here,
         as setting it here takes precedence over setting the nextflow variable
        NXF_SINGULARITY_CACHEDIR=singularity/ in your run script
         */
        //singularity.cacheDir   = "singularity/" // location of singularity images
        params.containerEngine = "singularity"
        includeConfig 'conf/by_docker_image.config'
    }

    docker {
        params.use_conda = false
        singularity.enabled = false
        conda.enabled = false

        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        params.containerEngine = "docker"
        includeConfig 'conf/by_docker_image.config'
    }

}

// Maximum number of jobs to submit in parallel
executor.queueSize = 20


/******************************************************************************************************************
***************** Tune process specific resources (cpu, memory etc.) ***********************************
*******************************************************************************************************************/

includeConfig 'conf/process_resources.config'

/*****************************************************************************
********************** Workflow Resource Usage Capturing *********************
******************************************************************************/

params.execution_trace_file = "${params.outdir}/Resource_Usage/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"

// Execution reports adapted from nf-core: https://github.com/nf-core
timeline {
    enabled = true
    file    = "${params.outdir}/Resource_Usage/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/Resource_Usage/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = params.execution_trace_file
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
}



/******************************************************************************
**************************** Workflow Metadata ********************************
*******************************************************************************/

manifest {
    author = 'Olabiyi Aderemi Obayomi, Mike D. Lee'
    homePage = 'https://github.com/nasa/GeneLab_Data_Processing/blob/master/Amplicon/'
    description = 'Amplicon Illumina workflow for pipeline document GL-DPPD-7104-D'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    nextflowVersion = '!>=26.04.2'
    version = '1.0.10'
}

includeConfig 'conf/post_processing.config'
validation.parametersSchema = params.post_processing.toString() == 'true' ? 'post_processing_schema.json' : 'nextflow_schema.json'
