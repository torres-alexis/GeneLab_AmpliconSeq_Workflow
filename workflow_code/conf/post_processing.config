params {
    single_end             = false // If true, pass --single-end to README and --single-ended to associations table and validation
    include_raw_data    = false // If true, includes Raw_Sequence_Data in README, associations table, and validation processes, and generates raw md5sum
    include_raw_multiqc = false // If true, pass --include-raw-multiqc-in-output to associations table (set to true only if raw data doesn't already exist in OSDR's assay table or if it needs to be modified)
    name             = "First M. Last" // name of analyst
    email            = "NASA@nasa.gov" // email of analyst
    protocol_id      = "GL-DPPD-7104-D" // Genelab pipeline document protocol id followed
    GLDS_accession   = null // e.g "GLDS-487"
    OSD_accession    = null // e.g "OSD-487"
    V_V_guidelines_link = "https://github.com/nasa/GeneLab_AmpliconSeq_Workflow/blob/main/README.md" // Dummy link
    target_files        = null // Defaults to command.txt and nextflow_processing_info with the effective assay suffix; e.g. "command.txt,nextflow_processing_info_16S_GLAmpSeq.txt" for 16S
    baseDir = "${launchDir}"
}
process {
    withName: 'PACKAGE_PROCESSING_INFO|GENERATE_README|VALIDATE_PROCESSING|GENERATE_CURATION_TABLE|GENERATE_MD5SUMS|GENERATE_PROTOCOL' {
        errorStrategy = 'ignore'
        cpus = 2
        memory = '5 GB'
    }
    withName: 'PACKAGE_PROCESSING_INFO|GENERATE_MD5SUMS' {
        containerOptions = { params.containerEngine == 'singularity' ? "-B ${launchDir.getParent()}" : "-v ${launchDir.getParent()}:${launchDir.getParent()}" }
    }
}
