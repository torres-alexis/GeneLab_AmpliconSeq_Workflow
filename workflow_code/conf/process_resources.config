process {

    //******************* Default process settings ************************//
    errorStrategy = { params.errorStrategy ? params.errorStrategy : "ignore" }
    maxRetries = 2
    cpus = 2
    memory = "5 GB"
    cache = 'lenient'
  //debug = true  // uncomment to see what is being emitted to the standard output

//********************************** Raw read staging ********************************************//
    withName: 'GET_ACCESSIONS|FETCH_ISA|ISA_TO_RUNSHEET|SELECT_RUNSHEET|NORMALIZE_RUNSHEET|UPDATE_OSDR_INPUTS|STAGE_ASV_TABLES|STAGE_METADATA' {
                  errorStrategy = 'terminate'
    }
    withName: COPY_READS {
                  maxRetries = 3
                  errorStrategy = 'retry'
            }
    withName: 'COPY_REMOTE_READS|DOWNLOAD_DATABASE' {
                  maxRetries = 3
                  maxForks = 5
                  errorStrategy = 'retry'
    }

//********************************** Read quality control and assessment ********************************************//
    withName: "CUTADAPT|COMBINE_CUTADAPT_LOGS_AND_SUMMARIZE" {
                  memory = "10 GB"
            }

//********************************** ASV table creation ********************************************//
    withName: "RUN_DADA2" {
                  memory = "20 GB"
                  cpus = 10
          }

//********************************** Diversity and differential abundance testing ********************************************//
    withLabel: visualization {
                  cpus = 5
                  errorStrategy = { task.exitStatus in [140, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
                  maxRetries = 4
                  memory = { task.attempt == 1 ? 10.GB : 32.GB * (task.attempt - 1) }
           }

}
