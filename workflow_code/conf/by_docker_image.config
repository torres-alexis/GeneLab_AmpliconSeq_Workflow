process {
    withName: 'GET_ACCESSIONS|FETCH_ISA|ISA_TO_RUNSHEET|SELECT_RUNSHEET|NORMALIZE_RUNSHEET|UPDATE_OSDR_INPUTS|STAGE_ASV_TABLES|PACKAGE_PROCESSING_INFO|GENERATE_README|VALIDATE_PROCESSING|GENERATE_CURATION_TABLE|GENERATE_MD5SUMS|GENERATE_PROTOCOL' {
        container = "quay.io/nasa_genelab/dp_tools:1.3.8"
    }
    withName: 'COPY_REMOTE_READS|DOWNLOAD_DATABASE' {
        container = "quay.io/nasa_genelab/wget:1.21.4"
    }
    withLabel: fastqc {
        container = "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"
    }
    withLabel: zip {
        container = "quay.io/nasa_genelab/zip:3.0"
    }
    withName: 'RAW_MULTIQC|FILTERED_MULTIQC' {
        container = "quay.io/biocontainers/multiqc:1.27.1--pyhdfd78af_0"
    }
    withName: 'CUTADAPT|COMBINE_CUTADAPT_LOGS_AND_SUMMARIZE' {
        container = "quay.io/biocontainers/cutadapt:5.2--py39hbcbf7aa_0"
    }
    withName: RUN_DADA2 {
        container = "quay.io/nasa_genelab/r-dada-decipher-biomformat:1.2"
    }
    withLabel: visualization {
        container = "quay.io/nasa_genelab/r-diversity:1.2"
    }
}
